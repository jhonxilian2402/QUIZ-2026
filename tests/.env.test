# Test environment. Loaded by the test runner via --env-file.
# These values are intentionally non-secret and are safe to commit.

NODE_ENV=test
LOG_LEVEL=error
DATABASE_DIR=memory://
RATE_LIMIT_DISABLED=false

# Fixed test value so hashing and session signing are reproducible in CI.
# This is not a production credential and must never be reused as one.
AUTH_SECRET=test-only-secret-value-not-used-in-production-0000000000

APP_URL=http://localhost:4311