# Example environment configuration.
#
# Copy to `.env` and fill in real values. `.env*` is git-ignored, so secrets are
# never committed. Every variable is optional in development except where noted;
# the server validates configuration at startup and fails with a clear message
# naming the variable (never its value) when something required is missing.

# development | test | production
NODE_ENV=development

# ------------------------------------------------------------------
# Required outside development/test
# ------------------------------------------------------------------

# Signs session cookies and reset tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public origin of the application. Used for absolute URLs and cookies.
APP_URL=http://localhost:4311

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

# PostgreSQL connection string. When unset, the embedded PostgreSQL (PGlite)
# is used for local development. Point this at a real server in production.
DATABASE_URL=

# Directory for the embedded development database. Ignored when DATABASE_URL
# is set.
DATABASE_DIR=.data/pglite

# ------------------------------------------------------------------
# OpenRouter (AI provider)
#
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_, never expose it to the
# browser, and never commit a real key. Without it the app keeps working and
# the model catalog reports itself as not configured.
# ------------------------------------------------------------------

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on the OpenRouter dashboard.
OPENROUTER_APP_NAME=

# Generation timeout in milliseconds (catalog/health probes use shorter ones).
OPENROUTER_TIMEOUT_MS=60000
# Extra attempts for transient failures only (never auth or validation errors).
OPENROUTER_MAX_RETRIES=2
# How long the normalized model catalog is cached before revalidation.
AI_MODEL_CACHE_TTL_MS=3600000
# Preferred platform model, validated against the live catalog before use.
# Leave empty for automatic selection of a compatible free model.
AI_DEFAULT_MODEL=
# Hard server-side cap for a single chat message, in characters.
AI_MAX_MESSAGE_LENGTH=8000
# Approximate token budget for conversation context sent to the model.
AI_CONTEXT_TOKEN_BUDGET=24000
# Quiz generation bounds and budgets.
QUIZ_MIN_QUESTIONS=1
QUIZ_MAX_QUESTIONS=50
QUIZ_GENERATION_TIMEOUT_MS=120000
QUIZ_GENERATION_MAX_ATTEMPTS=3
# External question source + web research (Part 9).
QUESTION_DB_BASE_URL=https://opentdb.com
WEB_RESEARCH_BASE_URL=https://en.wikipedia.org
QUESTION_SOURCE_TIMEOUT_MS=15000

# File pipeline (Part 10).
STORAGE_DIR=.data/storage
# Set to "supabase" for production object storage (persistent, private).
STORAGE_PROVIDER=local-disk
# Supabase Storage object store (production). Server-only credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
FILE_MAX_SIZE_MB=24
FILE_CHUNK_SIZE=1600
FILE_CHUNK_OVERLAP=200
FILE_MAX_ARCHIVE_MB=48
FILE_MAX_ARCHIVE_ENTRIES=5000
FILE_MAX_IMAGE_PIXELS=20000000
FILE_PROCESSING_TIMEOUT_MS=120000
OCR_ENABLED=true

# Reserved for later phases. Present so the deployment surface is known and
# deliberately unused. Never expose real values to the browser.
STORAGE_URL=
API_URL=

# ------------------------------------------------------------------
# Operations
# ------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# Set to true only in automated tests that must not be throttled.
RATE_LIMIT_DISABLED=false